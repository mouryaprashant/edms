# These values are intentionally used by the browser. The Supabase anon key is
# protected by Row Level Security, not by hiding it from the browser.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Google OAuth client ID and Drive folder ID are also browser-visible values.
# Do NOT put a Google client secret or service-account private key here.
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com
VITE_GDRIVE_ROOT_FOLDER_ID=YOUR_ROOT_DRIVE_FOLDER_ID
